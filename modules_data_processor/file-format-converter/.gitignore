# What gets pushed: Git only uploads *tracked* files. Ignored paths are never committed unless
# you force-add them. Check with: `git status`, `git check-ignore -v PATH`, or `git ls-files`.
#
# Track `pixi.lock`: it pins exact dependency versions (conda + PyPI) so CI and teammates resolve
# the same environment as you. The local `.pixi/` env is generated from the lockfile and stays
# untracked. Do not commit `.pixi/`.

# Pixi (also ignored from repo root; kept for standalone copies of this folder)
.pixi/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Test/type/lint cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
htmlcov/

# Build/package output
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Logs and local CLI I/O (prefer these dirs over ignoring *.csv globally)
*.log
logs/
output/
outputs/
tmp/
temp/

# Local env files
.env
.env.*
!.env.example
!.env.*.example
