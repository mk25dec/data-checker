# environment definitions for config_env
# REPO_ROOT is derived by the loader script at runtime

ENV_NAME=dev
APP_MODE=dev
PIXI_ENVIRONMENT=dev

REPO_ENV_PIXI=$REPO_ROOT/env

RUNTIME_DIR=$REPO_ROOT/run
RUNTIME_LOGS=$RUNTIME_DIR/logs
RUNTIME_IN=$RUNTIME_DIR/io/input
RUNTIME_OUT=$RUNTIME_DIR/io/output
RUNTIME_TMP=$RUNTIME_DIR/io/tmp
RUNTIME_USER_CONFIG=$RUNTIME_DIR/user-config

LOG_LEVEL=INFO
LOG_FORMAT=console
